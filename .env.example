# 蛮有味项目环境变量（模板）—— 复制为 .env 后填值；.env 已 gitignore，绝不入库 / 不进前端包。
# 本文件只列键与说明，不含任何真实密钥。

# DeepSeek API Key —— 自有 Node 后端(:8799) 跑 LLM 基座(Path B) 使用
DEEPSEEK_API_KEY=

# 高德 Web 服务 Key —— 后端(:8799) 调 restapi.amap.com 做「上传店铺」POI 校验（仅服务端）
AMAP_SERVER_KEY=

# ===== 账号体系（仅服务端）=====
# JWT 签名密钥（HS256）：生产请用强随机（如 `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`）。
AUTH_JWT_SECRET=

# 短信网关：console=开发/演示（控制台打印+返回 devCode，仅非生产）；生产须改 tencent 并配齐下方凭证。
SMS_PROVIDER=console
# 真实网关（SMS_PROVIDER=tencent 时必填；缺失则后端如实报「短信服务未配置」）：
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=

# 微信网页授权（留空=如实报「未配置」）：正式接入时填 AppID/AppSecret + 备案回调域名。
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_REDIRECT_URI=

# 前端落地页源（微信回跳 302 目标）
FRONTEND_ORIGIN=http://127.0.0.1:5180
ZHIPU_API_KEY=

# ─────────────────────────────────────────────────────────────
# 蛮有味 H5 构建期环境变量模板（复制为 h5/.env，已被根 .gitignore 忽略）
# 切勿把真实值提交进仓库！构建平台（Vercel / Netlify / CloudBase）
# 直接在后台注入同名变量即可，无需本文件。
# ─────────────────────────────────────────────────────────────

# ① 高德 Web端(JS API) Key —— 地图显示真实瓦片所需
#   申请：高德开放平台 console.amap.com → 应用管理 → 创建应用 → 添加 Key
#         「服务平台」选「Web端(JS API)」，并开启「安全密钥」。
#   安全必做（见 docs/高德Key安全接入.md）：
#     - 为 Key 配置「域名白名单」（限制可用域名，含你的部署域名与 localhost）；
#     - 启用「安全密钥」(securityJsCode)，下面第二项；
#     - 一旦泄露，立刻在高德控制台重置 Key。
#   未配置时：地图自动降级为离线坐标图（不白屏、不含任何明文 Key）。
VITE_AMAP_JS_API_KEY=

# ② 高德「安全密钥」(securityJsCode) —— JS API 2.0 强制配套，必须与上面的 Key 同应用
VITE_AMAP_SECURITY_CODE=

# ③ 百度统计（Tongji）站点 ID —— DAU/UV/PV/来源/地域开箱即用，无需后端
#   申请：tongji.baidu.com → 管理 → 新增网站 → 获取安装代码 → hm.js? 后面那串即站点 ID
#   未配置时：统计模块为空操作，业务不受影响（本地 dau() 仍可用）。
VITE_TONGJI_ID=
